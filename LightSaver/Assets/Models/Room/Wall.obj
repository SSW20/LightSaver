mtllib Room.mtl

o FrontWall

v -0.5 -0.5 0.0
v -0.5  0.5 0.0
v  0.5  0.5 0.0
v  0.5 -0.5 0.0

vt 0.0 2.0
vt 0.0 0.0
vt 4.0 0.0
vt 4.0 2.0

vn 0.0 0.0 -1.0
vn 0.0 0.0  1.0

usemtl RoomSurface

# Side facing a camera placed on negative Z
f 1/1/1 2/2/1 3/3/1
f 1/1/1 3/3/1 4/4/1

# Opposite side
f 3/3/2 2/2/2 1/1/2
f 4/4/2 3/3/2 1/1/2
